#!/usr/bin/env bash
# ==============================================================================
# zen-vsr: Native Video Super Resolution Launcher for Zen Browser
# Intercepts WebRender GL pipeline and injects AMD FidelityFX CAS / FSR
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB_VSR="${SCRIPT_DIR}/libzen_vsr.so"

if [ ! -f "${LIB_VSR}" ]; then
    echo -e "\033[1;33m[zen-vsr]\033[0m Building libzen_vsr.so first..."
    make -C "${SCRIPT_DIR}"
fi

export LIBVA_DRIVER_NAME=nvidia
export MOZ_DISABLE_RDD_SANDBOX=1
export NVD_BACKEND=direct

# Sharpness level: 0.10 (subtle) to 0.35 (strong), default 0.22
export ZEN_VSR_SHARPNESS="${ZEN_VSR_SHARPNESS:-0.22}"
export ZEN_VSR_DEBUG="${ZEN_VSR_DEBUG:-1}"

if [ -n "$LD_PRELOAD" ]; then
    export LD_PRELOAD="${LIB_VSR}:${LD_PRELOAD}"
else
    export LD_PRELOAD="${LIB_VSR}"
fi

ZEN_BIN="/opt/zen-browser-bin/zen-bin"
if [ ! -x "${ZEN_BIN}" ]; then
    ZEN_BIN="$(which zen-browser 2>/dev/null || which zen 2>/dev/null)"
fi

if [ -z "${ZEN_BIN}" ]; then
    echo -e "\033[1;31m[zen-vsr Error]\033[0m Could not locate Zen browser binary!"
    exit 1
fi

echo -e "\033[1;32m[zen-vsr]\033[0m Launching Zen with Native Super Resolution (VSR)..."
exec "${ZEN_BIN}" "$@"
